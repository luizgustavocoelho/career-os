# Copie para .env na raiz. Nunca versione o arquivo .env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/careeros.db
APP_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
REGISTRATION_ENABLED=true
# 1 = primeira conta apenas. 0 = sem limite (somente se desejado).
REGISTRATION_LIMIT=1
SESSION_DAYS=7
UPLOAD_MAX_MB=8
DATA_DIR=data

# IA opcional para operações básicas; necessária para Career Coach e interpretação semântica.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=30

# Docker Compose. Gere uma senha alfanumérica longa antes de executar.
POSTGRES_USER=careeros
POSTGRES_DB=careeros
POSTGRES_PASSWORD=

# Deploy com Caddy (HTTPS).
DOMAIN=
ACME_EMAIL=

# Hostnames adicionais de desenvolvimento; o modo Share define automaticamente.
NEXT_ALLOWED_DEV_ORIGINS=
